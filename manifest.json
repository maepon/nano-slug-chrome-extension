{
  "manifest_version": 3,
  "name": "Nano Slug Generator",
  "version": "0.1.5",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "images/icon/nano-slug-16.png",
    "32": "images/icon/nano-slug-32.png",
    "64": "images/icon/nano-slug-64.png",
    "128": "images/icon/nano-slug-128.png"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "generate-slug": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "__MSG_generateSlug__"
    }
  }
}
